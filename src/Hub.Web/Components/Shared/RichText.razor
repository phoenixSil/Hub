@* Affiche un texte simple saisi dans le back-office, ligne par ligne :
   « ## » = intertitre, « ### » = sous-titre, « - » = élément de liste,
   ligne vide = nouveau paragraphe, **gras**.
   Tout le texte est encodé : aucun HTML saisi n'est interprété. *@
<div class="rich @Class">@((MarkupString)Render(Text))</div>

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Class { get; set; }

    public static string Render(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;

        var sb = new System.Text.StringBuilder();
        var paragraph = new List<string>();
        var inList = false;

        void FlushParagraph()
        {
            if (paragraph.Count == 0) return;
            sb.Append("<p>").Append(string.Join("<br>", paragraph.Select(Inline))).Append("</p>");
            paragraph.Clear();
        }

        void CloseList()
        {
            if (!inList) return;
            sb.Append("</ul>");
            inList = false;
        }

        foreach (var rawLine in text.Replace("\r\n", "\n").Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0)
            {
                FlushParagraph();
                CloseList();
            }
            else if (line.StartsWith("### "))
            {
                FlushParagraph(); CloseList();
                sb.Append("<h3>").Append(Inline(line[4..])).Append("</h3>");
            }
            else if (line.StartsWith("## "))
            {
                FlushParagraph(); CloseList();
                sb.Append("<h2>").Append(Inline(line[3..])).Append("</h2>");
            }
            else if (line.StartsWith("- "))
            {
                FlushParagraph();
                if (!inList) { sb.Append("<ul>"); inList = true; }
                sb.Append("<li>").Append(Inline(line[2..])).Append("</li>");
            }
            else
            {
                CloseList();
                paragraph.Add(line);
            }
        }
        FlushParagraph();
        CloseList();
        return sb.ToString();
    }

    /// <summary>Encode le texte et rend **gras** en &lt;strong&gt;.</summary>
    private static string Inline(string s)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(s.Trim());
        var parts = encoded.Split("**");
        if (parts.Length < 3) return encoded;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1 && i < parts.Length - 1) sb.Append("<strong>").Append(parts[i]).Append("</strong>");
            else if (i % 2 == 1) sb.Append("**").Append(parts[i]);
            else sb.Append(parts[i]);
        }
        return sb.ToString();
    }
}
