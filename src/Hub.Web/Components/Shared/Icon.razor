        "leaf", "thumbs-up", "award", "phone", "mail", "map-pin", "calendar", "check", "sparkles",
        "wrench", "file-signature", "phone-call", "arrow-right", "menu", "x", "message", "percent", "quote",
        "chevron-down", "external", "zap", "whatsapp", "facebook", "instagram", "youtube",
    ];

