@* Icônes au trait (inspirées de Lucide), dessinées en SVG pour ne charger aucune police d'icônes. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @((MarkupString)PathFor(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "sparkles";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }

