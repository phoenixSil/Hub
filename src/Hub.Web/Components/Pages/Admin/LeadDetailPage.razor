@page "/admin/demandes/{Id:guid}"
@rendermode InteractiveServer
@inject ILeadInbox Leads
@inject IContentQueries ContentQueries
@inject AuthenticationStateProvider Auth

<PageTitle>Demande</PageTitle>

@if (detail is null)
{
    <p class="muted">@(notFound ? "Demande introuvable." : "Chargement…")</p>
    return;
}

@{ var l = detail.Lead; }

<div class="admin-head">
    <div>
        <p class="muted small"><a href="/admin/demandes">← Demandes</a></p>
        <h1>@l.FullName</h1>
        <p class="muted">
            <span class="tag tag-@l.Kind.ToString().ToLowerInvariant()">@LeadLabels.Of(l.Kind)</span>
            reçue le @AdminFormat.Local(l.CreatedAt, "dddd d MMMM yyyy 'à' HH:mm")
        </p>
    </div>
    <div class="status-picker">
        <label for="status">Statut</label>
        <select id="status" value="@l.Status" @onchange="ChangeStatusAsync">
            @foreach (var s in Enum.GetValues<LeadStatus>())
            {
                <option value="@s">@LeadLabels.Of(s)</option>
            }
        </select>
    </div>
</div>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-error" : "alert-success")">@message</div>
}

<div class="admin-columns">
    <div class="admin-card">
        <h2>Coordonnées</h2>
        <dl class="details">
            <dt>Courriel</dt><dd><a href="mailto:@l.Email">@l.Email</a></dd>
            @if (l.Phone is not null) { <dt>Téléphone</dt><dd><a href="tel:@l.Phone">@l.Phone</a></dd> }
            @if (l.Address is not null) { <dt>Adresse</dt><dd>@l.Address</dd> }
            @if (l.AreaSlug is not null) { <dt>Secteur</dt><dd>@AreaName(l.AreaSlug)</dd> }
        </dl>

        <h2>Demande</h2>
        <dl class="details">
            @if (l.Services is not null) { <dt>Services</dt><dd>@l.Services</dd> }
            @if (l.PropertyType is not null) { <dt>Propriété</dt><dd>@l.PropertyType</dd> }
            @if (l.PropertySize is not null) { <dt>Superficie</dt><dd>@l.PropertySize</dd> }
            @if (l.Frequency is not null) { <dt>Fréquence</dt><dd>@l.Frequency</dd> }
            @if (l.Subject is not null) { <dt>Sujet</dt><dd>@l.Subject</dd> }
            @if (l.PreferredDate is { } d)
            {
                <dt>Date souhaitée</dt>
                <dd>@d.ToString("dddd d MMMM yyyy", AdminFormat.Fr)@(l.PreferredSlot is { } s ? ", " + LeadLabels.Of(s) : "")</dd>
            }
            @if (l.ConfirmedFor is { } c) { <dt>Rendez-vous confirmé</dt><dd><strong>@AdminFormat.Local(c, "dddd d MMMM yyyy 'à' HH:mm")</strong></dd> }
        </dl>
        @if (l.Message is not null)
        {
            <div class="message-box">@l.Message</div>
        }

        <h2>Provenance</h2>
        <dl class="details">
            <dt>Source</dt><dd>@(l.Source ?? "Directe ou inconnue") @(l.Medium is null ? "" : $"({l.Medium})")</dd>
            @if (l.Campaign is not null) { <dt>Campagne</dt><dd>@l.Campaign</dd> }
            @if (l.LandingPage is not null) { <dt>Page d'arrivée</dt><dd>@l.LandingPage</dd> }
        </dl>
    </div>

    <div>
        @if (l.Kind == LeadKind.Quote || l.Services is not null)
        {
            <QuoteAssistantPanel LeadId="@l.Id" Kind="@l.Kind" OnSent="QuoteSentAsync" />
        }

        @if (l.Kind == LeadKind.Appointment || l.PreferredDate is not null)
        {
            <div class="admin-card">
                <h2>Confirmer le rendez-vous</h2>
                <p class="muted small">Le client reçoit un courriel de confirmation et la demande passe à « Planifiée ».</p>
                <div class="field">
                    <label>Date et heure</label>
                    <input type="datetime-local" @bind="confirmAt" />
                </div>
                <div class="field">
                    <label>Message au client (facultatif)</label>
                    <textarea rows="2" @bind="confirmNote" placeholder="ex. Notre préposée Marie se présentera à 9 h."></textarea>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="ConfirmAsync" disabled="@(confirmAt is null || busy)">Confirmer et envoyer</button>
            </div>
        }

        <div class="admin-card reply-card">
            <h2>Répondre par courriel</h2>
            <p class="muted small">Envoyé à <strong>@l.Email</strong> au nom de l'entreprise ; si le client répond, sa réponse arrive dans votre boîte courriel habituelle.
                L'envoi est noté dans le suivi ci-dessous.</p>
            @if (replyResult is not null)
            {
                <div class="alert @(replyIsError ? "alert-error" : "alert-success")" role="status">@replyResult</div>
            }
            <div class="field">
                <label for="rsubject">Sujet</label>
                <input id="rsubject" @bind="replySubject" maxlength="200" />
                <FieldError Errors="replyErrors" For="Subject" />
            </div>
            <div class="field">
                <label for="rbody">Message</label>
                <textarea id="rbody" rows="12" @bind="replyBody" placeholder="Collez ou écrivez votre réponse. Une ligne vide sépare les paragraphes ; les lignes qui commencent par « - » deviennent une liste."></textarea>
                <FieldError Errors="replyErrors" For="Body" />
            </div>
            <div class="field">
                <label for="rfiles">Pièces jointes (PDF, images, Word, Excel · 15 Mo au total)</label>
                <InputFile id="rfiles" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.docx,.xlsx" OnChange="AddFilesAsync" />
                <FieldError Errors="replyErrors" For="Attachments" />
                @if (replyFiles.Count > 0)
                {
                    <ul class="attachment-list">
                        @foreach (var f in replyFiles)
                        {
                            <li>
                                <span><Icon Name="file-signature" Size="14" /> @f.FileName <span class="muted small">(@Size(f.Content.Length))</span></span>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => replyFiles.Remove(f)" aria-label="Retirer @f.FileName">Retirer</button>
                            </li>
                        }
                    </ul>
                }
            </div>
            <BusyButton OnClick="SendReplyAsync" IsBusy="sending" BusyText="Envoi…">Envoyer le courriel</BusyButton>
        </div>

        <div class="admin-card">
            <h2>Suivi</h2>
            <div class="field">
                <textarea rows="3" @bind="note" @bind:event="oninput" placeholder="Ajouter une note (appel, devis envoyé, prix proposé…)"></textarea>
            </div>
            <button class="btn btn-outline btn-sm" @onclick="AddNoteAsync" disabled="@string.IsNullOrWhiteSpace(note)">Ajouter la note</button>

            <ol class="timeline">
                @foreach (var a in detail.Activities)
                {
                    <li>
                        <span class="muted small">@AdminFormat.Local(a.CreatedAt) · @a.Author</span>
                        <strong>@a.Action</strong>
                        @if (a.Note is not null) { <p class="timeline-note">@a.Note</p> }
                    </li>
                }
            </ol>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private LeadDetail? detail;
    private bool notFound;
    private string? note;
    private DateTime? confirmAt;
    private string? confirmNote;
    private bool busy;
    private string? message;
    private bool messageIsError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // Réponse par courriel
    private string? replySubject;
    private string? replyBody;
    private readonly List<Hub.SharedKernel.Email.EmailAttachment> replyFiles = [];
    private IReadOnlyDictionary<string, string>? replyErrors;
    private string? replyResult;
    private bool replyIsError;
    private bool sending;

    private async Task AddFilesAsync(InputFileChangeEventArgs e)
    {
        replyErrors = null;
        foreach (var file in e.GetMultipleFiles(Hub.Modules.Leads.Application.LeadEmailLimits.MaxAttachments))
        {
            var ext = Path.GetExtension(file.Name);
            if (!Hub.SharedKernel.Email.EmailAttachment.AllowedTypes.TryGetValue(ext, out var type))
            {
                replyErrors = new Dictionary<string, string> { ["Attachments"] = $"« {file.Name} » : seuls les PDF, images, documents Word et Excel sont permis." };
                continue;
            }
            if (replyFiles.Sum(f => (long)f.Content.Length) + file.Size > Hub.SharedKernel.Email.EmailAttachment.MaxTotalBytes)
            {
                replyErrors = new Dictionary<string, string> { ["Attachments"] = "Les pièces jointes dépassent 15 Mo au total." };
                continue;
            }
            await using var stream = file.OpenReadStream(Hub.SharedKernel.Email.EmailAttachment.MaxTotalBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            replyFiles.Add(new Hub.SharedKernel.Email.EmailAttachment(Path.GetFileName(file.Name), type, memory.ToArray()));
        }
    }

    private async Task SendReplyAsync()
    {
        if (sending) return;
        sending = true;
        replyResult = null;
        try
        {
            var result = await Leads.SendReplyAsync(Id, replySubject ?? "", replyBody ?? "", replyFiles.ToList(), await AuthorAsync());
            replyErrors = result.FieldErrors;
            replyIsError = result.IsFailure;
            replyResult = result.IsSuccess
                ? $"Courriel envoyé à {detail?.Lead.Email}{(replyFiles.Count > 0 ? $" avec {replyFiles.Count} pièce(s) jointe(s)" : "")}."
                : result.FieldErrors.Count > 0 ? "Vérifiez les champs signalés." : result.Error;
            if (result.IsSuccess)
            {
                replySubject = null;
                replyBody = null;
                replyFiles.Clear();
                await LoadAsync();
            }
        }
        finally { sending = false; }
    }

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024:0.0} Mo" : $"{Math.Max(1, bytes / 1024)} Ko";

    private IReadOnlyList<ServiceArea> areas = [];

    private string AreaName(string slug) =>
        slug == "autre" ? "Autre secteur" : areas.FirstOrDefault(a => a.Slug == slug)?.Name ?? slug;

    private async Task LoadAsync()
    {
        if (areas.Count == 0) areas = (await ContentQueries.GetAsync()).Areas;
        detail = await Leads.GetAsync(Id);
        notFound = detail is null;
        if (detail is not null && replySubject is null)
            replySubject = detail.Lead.Subject is { Length: > 0 } subj ? (subj.StartsWith("Re", StringComparison.OrdinalIgnoreCase) ? subj : "Re : " + subj) : "Votre demande";
        if (detail?.Lead.PreferredDate is { } d && confirmAt is null)
        {
            var hour = detail.Lead.PreferredSlot switch { TimeSlot.Afternoon => 13, TimeSlot.LateDay => 16, _ => 9 };
            confirmAt = d.ToDateTime(new TimeOnly(hour, 0));
        }
    }

    private async Task<string> AuthorAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        return user.FindFirst("hub:name")?.Value ?? user.Identity?.Name ?? "Administrateur";
    }

    private async Task ChangeStatusAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<LeadStatus>(e.Value?.ToString(), out var s))
        {
            await Leads.ChangeStatusAsync(Id, s, await AuthorAsync());
            await LoadAsync();
        }
    }

    private async Task AddNoteAsync()
    {
        await Leads.AddNoteAsync(Id, note!, await AuthorAsync());
        note = null;
        await LoadAsync();
    }

    private async Task QuoteSentAsync((decimal Sent, decimal Proposed) totals)
    {
        var author = await AuthorAsync();
        var fr = AdminFormat.Fr;
        var noteText = totals.Sent == totals.Proposed
            ? $"Proposition de l'assistant envoyée telle quelle : {totals.Sent.ToString("#,##0.00 $", fr)} avant taxes."
            : $"Proposition envoyée : {totals.Sent.ToString("#,##0.00 $", fr)} avant taxes (l'assistant proposait {totals.Proposed.ToString("#,##0.00 $", fr)}).";
        await Leads.AddNoteAsync(Id, noteText, author);
        if (detail?.Lead.Status is LeadStatus.New or LeadStatus.Contacted)
            await Leads.ChangeStatusAsync(Id, LeadStatus.QuoteSent, author);
        await LoadAsync();
    }

    private async Task ConfirmAsync()
    {
        if (confirmAt is null) return;
        busy = true;
        var result = await Leads.ConfirmAppointmentAsync(Id, Hub.SharedKernel.Time.BusinessTime.FromLocal(confirmAt.Value), confirmNote, await AuthorAsync());
        busy = false;
        message = result.IsSuccess ? "Rendez-vous confirmé : le client a reçu un courriel." : result.Error;
        messageIsError = result.IsFailure;
        await LoadAsync();
    }
}
