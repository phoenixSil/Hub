@page "/admin/canaux"
@rendermode InteractiveServer
@using Hub.Modules.Channels

@inject IPublisherResolver Publishers

<PageTitle>Canaux</PageTitle>

<div class="admin-head">
    <div>
        <h1>Connexions aux réseaux</h1>
        <p class="muted">Reliez vos pages pour publier depuis le back-office (menu Publications).</p>
    </div>
</div>

@foreach (var c in Publishers.Supported)
{
    <ChannelConnectionPanel Channel="c" />
}

<CrudEditor T="Channel" Title="Canaux de présence en ligne" Context="c" AllowDelete="false"
            Help="Liste de vos présences en ligne (adresse, état). Facebook et Instagram se publient depuis le back-office ; Google Business arrivera ensuite."
            Query="@(q => q.OrderBy(x => x.Phase).ThenBy(x => x.Type))">
    <Header><th>Canal</th><th>État</th><th>Phase</th><th>Adresse</th></Header>
    <Row>
        <td>@c.Type</td>
        <td><span class="status status-@c.Status.ToString().ToLowerInvariant()">@StatusLabel(c.Status)</span></td>
        <td>@c.Phase</td>
        <td>@if (!string.IsNullOrWhiteSpace(c.Url)) {<a href="@c.Url" target="_blank">@c.Url</a>}</td>
    </Row>
    <Form>
        <div class="field-row">
            <div class="field">
                <label>Canal</label>
                <InputSelect @bind-Value="c.Type">
                    @foreach (var t in Enum.GetValues<ChannelType>())
                    {
                        <option value="@t">@t</option>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label>État</label>
                <InputSelect @bind-Value="c.Status">
                    @foreach (var s in Enum.GetValues<ChannelStatus>())
                    {
                        <option value="@s">@StatusLabel(s)</option>
                    }
                </InputSelect>
            </div>
            <div class="field"><label>Phase</label><InputNumber @bind-Value="c.Phase" /></div>
        </div>
        <div class="field"><label>Adresse</label><InputText @bind-Value="c.Url" /></div>
        <div class="field"><label>Notes</label><InputTextArea rows="3" @bind-Value="c.Notes" /></div>
    </Form>
</CrudEditor>

@code {
    private static string StatusLabel(ChannelStatus s) => s switch
    {
        ChannelStatus.Active => "Actif",
        ChannelStatus.Paused => "En pause",
        _ => "Prévu",
    };
}
