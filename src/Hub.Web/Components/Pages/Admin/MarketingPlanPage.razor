@page "/admin/plan-marketing"
@rendermode InteractiveServer
@inject IMarketingPlanService Plans
@inject TimeProvider Clock
@inject IJSRuntime Js

<PageTitle>Campagne</PageTitle>

<MarketingTabs />

<div class="admin-head">
    <div>
        <h1>Campagne</h1>
        <p class="muted">
            Où en est votre campagne, ses thèmes et ses chiffres. Les publications elles-mêmes sont dans le <a href="/admin/marketing">calendrier</a>.
        </p>
    </div>
    @if (view is { Status: PlanStatus.Active })
    {
        <BusyButton OnClick="RefreshAsync" IsBusy="@(action == "refresh")" BusyText="Relevé en cours…" Class="btn btn-outline">Relever les chiffres</BusyButton>
    }
</div>

@if (working is not null)
{
    <div class="alert alert-info busy-banner" role="status"><span class="spinner" aria-hidden="true"></span> @working</div>
}
else if (feedback is not null)
{
    <div class="alert @(feedbackIsError ? "alert-error" : "alert-success")">@feedback</div>
}

@if (!loaded)
{
    <p class="muted">Chargement…</p>
}
else
{
    @if (plans.Count > 0)
    {
        <div class="admin-card plan-list">
            <div class="plan-list-head">
                <h2>Mes campagnes</h2>
                <a class="btn btn-outline btn-sm" href="/admin/marketing/nouvelle-campagne">Nouvelle campagne</a>
            </div>
            <p class="muted small">Une seule campagne tourne à la fois. Les autres attendent en réserve et peuvent prendre le relais toutes seules à la fin de la campagne en cours.</p>
            <table class="admin-table plan-list-table">
                <thead><tr><th>Campagne</th><th>Statut</th><th>Période</th><th class="num">Par semaine</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in plans)
                    {
                        <tr class="@(view?.Id == p.Id ? "is-selected" : null)">
                            <td><strong>@p.Name</strong></td>
                            <td>
                                <span class="status status-@StatusClass(p.Status)">@StatusLabel(p.Status)</span>
                                @if (p.StartsAutomatically) { <br /><span class="muted small">Démarre toute seule le @AdminFormat.Day(p.StartsOn)</span> }
                                @if (p.StoppedOn is { } stopped) { <br /><span class="muted small">Arrêtée le @AdminFormat.Day(stopped)</span> }
                            </td>
                            <td>@AdminFormat.Day(p.StartsOn) → @AdminFormat.Day(p.EndsOn)</td>
                            <td class="num">@p.PostsPerWeek</td>
                            <td class="actions">
                                @if (view?.Id != p.Id)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => SelectAsync(p.Id)" disabled="@busy">Ouvrir</button>
                                }
                                else if (p.Status == PlanStatus.Active && !stopping)
                                {
                                    <button class="btn btn-outline-danger btn-sm" @onclick="StartStopping" disabled="@busy">Arrêter la campagne</button>
                                }
                                else
                                {
                                    <span class="muted small">Affiché ci-dessous</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (plans.Count == 0)
    {
        <div class="admin-card plan-create">
            <h2>Aucune campagne pour l'instant</h2>
            <p>Trois questions, puis vous voyez la première semaine de publications avant de démarrer.</p>
            <a class="btn btn-primary" href="/admin/marketing/nouvelle-campagne">Créer une campagne</a>
        </div>
    }

    @if (view is { } v)
    {
    <div class="plan-status">
        <span class="status status-@StatusClass(v.Status)">@StatusLabel(v.Status)</span>
        <strong>@v.Name</strong>
        <span class="muted">
            @AdminFormat.Day(v.StartsOn) → @AdminFormat.Day(v.EndsOn) · @v.PostsPerWeek publications par semaine
            @if (v.Status == PlanStatus.Active && v.Week > 0) { <text> · semaine @v.Week sur @v.TotalWeeks</text> }
        </span>
        @if (v.Status == PlanStatus.Draft)
        {
            <span class="plan-status-actions">
                @if (activePlan is null)
                {
                    <BusyButton OnClick="ActivateAsync" IsBusy="@(action == "activate")" BusyText="Lancement…">Démarrer la campagne</BusyButton>
                }
                <button class="btn btn-ghost btn-sm" @onclick="DeleteDraftAsync" disabled="@busy">Supprimer</button>
            </span>
        }
        else if (v.Status == PlanStatus.Active && !stopping)
        {
            <span class="plan-status-actions">
                <BusyButton Class="btn btn-outline btn-sm" OnClick="TogglePauseAsync" IsBusy="@(action == "pause")" AnyBusy="busy" BusyText="…">@(paused ? "Reprendre" : "Mettre en pause")</BusyButton>
                <button class="btn btn-outline-danger btn-sm" @onclick="StartStopping" disabled="@busy">Arrêter la campagne</button>
            </span>
        }
    </div>

    @if (v.Status == PlanStatus.Active && paused)
    {
        <div class="alert alert-info">Campagne en pause : aucune nouvelle publication n'est préparée. Celles déjà prévues dans le calendrier partent toujours.</div>
    }

    @if (v.Status == PlanStatus.Draft)
    {
        var selected = plans.FirstOrDefault(p => p.Id == v.Id);
        <div class="alert alert-info plan-reserve">
            @if (activePlan is not null)
            {
                <p><strong>Campagne en réserve.</strong> La campagne « @activePlan.Name » est en cours jusqu'au @AdminFormat.Day(activePlan.EndsOn) :
                   celle-ci ne peut pas démarrer tant qu'elle tourne (jamais deux campagnes en même temps). Arrêtez la campagne en cours,
                   ou programmez celle-ci pour qu'elle prenne le relais toute seule.</p>
            }
            else
            {
                <p>Au démarrage, les publications de la campagne sont préparées à son rythme et apparaissent dans le calendrier.
                   Pendant le premier mois, chaque publication attend votre accord.</p>
            }
            <label class="check">
                <input type="checkbox" checked="@(selected?.StartsAutomatically == true)" disabled="@busy" @onchange="ToggleAutoStartAsync" />
                @(activePlan is not null
                    ? $"Démarrer automatiquement à la fin de la campagne en cours (le {AdminFormat.Day(activePlan.EndsOn.AddDays(1))})"
                    : $"Démarrer automatiquement à sa date de début (le {AdminFormat.Day(v.StartsOn)})")
            </label>
        </div>
    }

    @if (v.Status == PlanStatus.Active && stopping)
    {
        <div class="admin-card plan-stop">
            <h2>Arrêter la campagne ?</h2>
            <p>La campagne passe dans l'historique avec ses chiffres. Les publications du pilote <strong>pas encore parues</strong> (à valider ou programmées) sont annulées.
               Les publications déjà parues et celles écrites à la main ne sont pas touchées. Une campagne arrêtée ne se relance pas : vous pourrez en créer une autre.</p>
            <fieldset class="plan-stop-choice">
                <legend>Ensuite, le pilote automatique :</legend>
                <label class="check"><input type="radio" name="after-stop" checked="@pauseAutopilot" @onchange="() => pauseAutopilot = true" /> se met en pause (plus aucune publication préparée)</label>
                <label class="check"><input type="radio" name="after-stop" checked="@(!pauseAutopilot)" @onchange="() => pauseAutopilot = false" /> continue sans campagne, à son rythme actuel</label>
            </fieldset>
            <div class="actions">
                <BusyButton Class="btn btn-danger" OnClick="StopAsync" IsBusy="@(action == "stop")" BusyText="Arrêt…">Oui, arrêter la campagne</BusyButton>
                <button class="btn btn-ghost btn-sm" @onclick="() => stopping = false" disabled="@busy">Annuler</button>
            </div>
        </div>
    }

    @if (v.ProposedTargets is not null || v.ProposedPillars is not null || v.SuggestAutoPublish)
    {
        <div class="admin-card plan-proposals">
            <h2>À approuver</h2>
            @if (v.ProposalNote is not null) { <p>@v.ProposalNote</p> }
            @if (v.ProposedTargets is { } t)
            {
                <div class="plan-proposal">
                    <div>
                        <strong>Cibles de fin de campagne</strong>
                        <p class="muted">@t.WeeklyReach.ToString("N0", Fr) personnes atteintes par semaine · @t.Followers.ToString("N0", Fr) abonnés · @Pct(t.EngagementRate) d'interaction</p>
                    </div>
                    <BusyButton OnClick="ApproveTargetsAsync" IsBusy="@(action == "targets")" BusyText="…">Approuver les cibles</BusyButton>
                </div>
            }
            @if (v.ProposedPillars is { } pp)
            {
                <div class="plan-proposal">
                    <div>
                        <strong>Nouvelle répartition des contenus</strong>
                        <p class="muted">@string.Join(" · ", pp.Select(p => $"{p.Name} {p.Share} %"))</p>
                    </div>
                    <span class="actions">
                        <BusyButton OnClick="ApprovePillarsAsync" IsBusy="@(action == "pillars")" BusyText="…">Appliquer</BusyButton>
                        <button class="btn btn-ghost btn-sm" @onclick="DismissAsync" disabled="@busy">Garder l'actuelle</button>
                    </span>
                </div>
            }
            @if (v.SuggestAutoPublish)
            {
                <div class="plan-proposal">
                    <div>
                        <strong>Passer en publication automatique ?</strong>
                        <p class="muted">Le premier mois est écoulé. Si la qualité des publications vous convient, elles peuvent partir seules à l'heure prévue. Le résumé du lundi continue de vous informer.</p>
                    </div>
                    <BusyButton OnClick="AutoPublishAsync" IsBusy="@(action == "auto")" BusyText="…">Publier sans me demander</BusyButton>
                </div>
            }
        </div>
    }

    @if (v.InsightsNote is not null)
    {
        <div class="alert alert-warning">Chiffres incomplets : @v.InsightsNote</div>
    }

    <div class="kpi-grid plan-kpis">
        @Kpi("Personnes atteintes (7 jours)", v.Current.WeeklyReach.ToString("N0", Fr), v.Baseline?.WeeklyReach.ToString("N0", Fr), v.Targets?.WeeklyReach.ToString("N0", Fr), v.Expected is null ? null : v.Current.WeeklyReach >= v.Expected.WeeklyReach * 0.9)
        @Kpi("Abonnés (Facebook + Instagram)", v.Current.Followers.ToString("N0", Fr), v.Baseline?.Followers.ToString("N0", Fr), v.Targets?.Followers.ToString("N0", Fr), v.Expected is null ? null : v.Current.Followers >= v.Expected.Followers * 0.97)
        @Kpi("Taux d'interaction (28 jours)", Pct(v.Current.EngagementRate), v.Baseline is null ? null : Pct(v.Baseline.EngagementRate), v.Targets is null ? null : Pct(v.Targets.EngagementRate), v.Expected is null ? null : v.Current.EngagementRate >= v.Expected.EngagementRate * 0.9)
    </div>
    @if (v.Baseline is null && v.Status == PlanStatus.Active)
    {
        <p class="muted small">Le point de départ est mesuré après la première semaine de la campagne. Des cibles réalistes vous sont ensuite proposées.</p>
    }
    else if (v.Expected is { } e)
    {
        <p class="muted small">Trajectoire visée aujourd'hui : @e.WeeklyReach.ToString("N0", Fr) personnes atteintes par semaine et @e.Followers.ToString("N0", Fr) abonnés.
            @(v.OnTrack == true ? "La campagne est dans les temps." : "La campagne prend du retard : les publications misent davantage sur ce qui atteint le plus de monde.")</p>
    }

    <div class="admin-card">
        <h2>Étapes</h2>
        <div class="plan-timeline" role="list">
            @foreach (var p in v.Phases)
            {
                var days = Math.Max(1, p.To.DayNumber - p.From.DayNumber + 1);
                var isCurrent = v.CurrentPhase == p;
                <div role="listitem" class="plan-phase @(isCurrent ? "is-current" : today > p.To ? "is-done" : null)" style="flex-grow:@days">
                    <span class="plan-phase-dates">@AdminFormat.Day(p.From) → @AdminFormat.Day(p.To)</span>
                    <strong>@p.Name</strong>
                    <span>@p.Focus</span>
                    <span class="plan-theme">Thème : @p.Theme</span>
                    @if (isCurrent) { <span class="plan-now" style="left:@NowPosition(p)%"></span> }
                </div>
            }
        </div>
    </div>

    <div class="admin-columns">
        <div class="admin-card">
            <h2>Semaine par semaine</h2>
            @if (v.Weeks.Count == 0)
            {
                <p class="muted">Les chiffres apparaîtront dès la première semaine de la campagne.</p>
            }
            else
            {
                var max = Math.Max(1, v.Weeks.Max(w => w.Reach));
                <div class="bar-chart" aria-label="Personnes atteintes par semaine">
                    @foreach (var w in v.Weeks)
                    {
                        <div class="bar-col" title="Semaine du @AdminFormat.Day(w.WeekOf) : @w.Posts publication(s), @w.Reach.ToString("N0", Fr) personnes atteintes, @w.Interactions interactions">
                            <div class="bar" style="height:@((100.0 * w.Reach / max).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
                        </div>
                    }
                </div>
                <div class="bar-axis"><span>@AdminFormat.Day(v.Weeks[0].WeekOf)</span><span>personnes atteintes par semaine</span><span>@AdminFormat.Day(v.Weeks[^1].WeekOf)</span></div>
            }
        </div>

        <div class="admin-card">
            <h2>Répartition des contenus</h2>
            <table class="admin-table compare-table plan-mix">
                <thead><tr><th>Pilier</th><th class="num">Visée</th><th>Réelle</th><th class="num">Atteintes / publ.</th></tr></thead>
                <tbody>
                    @foreach (var m in v.Mix)
                    {
                        <tr>
                            <td title="@v.Pillars.FirstOrDefault(p => p.Name == m.Name)?.Description">@m.Name</td>
                            <td class="num">@m.TargetShare %</td>
                            <td>
                                <div class="meter" title="@m.Posts publication(s)">
                                    <div style="width:@(Math.Min(100, m.ActualShare).ToString("0.#", CultureInfo.InvariantCulture))%"></div>
                                    <span>@m.ActualShare.ToString("0", Fr) %</span>
                                </div>
                            </td>
                            <td class="num">@(m.AvgReach > 0 ? m.AvgReach.ToString("N0", Fr) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted small">La part réelle compte les publications de la campagne déjà parues ou prévues.</p>
        </div>
    </div>

    @if (form is not null && v.Status is PlanStatus.Draft or PlanStatus.Active)
    {
        <details class="admin-card plan-edit" open="@(v.Status == PlanStatus.Draft)">
            <summary><h2>Réglages avancés : étapes, thèmes et répartition</h2></summary>
            <div class="field-row">
                <div class="field">
                    <label for="plan-name">Nom</label>
                    <input id="plan-name" @bind="form.Name" />
                    <FieldError Errors="errors" For="Name" />
                </div>
                <div class="field">
                    <label for="plan-posts">Publications par semaine</label>
                    <select id="plan-posts" @bind="form.PostsPerWeek">
                        @for (var n = 1; n <= AutopilotSchedule.MaxPostsPerWeek; n++) { var x = n; <option value="@x">@RythmLabel(x)</option> }
                    </select>
                    <FieldError Errors="errors" For="PostsPerWeek" />
                </div>
            </div>

            <h3>Étapes</h3>
            <FieldError Errors="errors" For="Phases" />
            @foreach (var p in form.Phases)
            {
                <div class="plan-edit-block">
                    <div class="field-row">
                        <div class="field"><label>Nom</label><input @bind="p.Name" /></div>
                        <div class="field"><label>Du</label><input type="date" @bind="p.From" /></div>
                        <div class="field"><label>Au</label><input type="date" @bind="p.To" /></div>
                    </div>
                    <div class="field"><label>Ce qu'on cherche à faire</label><textarea rows="2" @bind="p.Focus"></textarea></div>
                    <div class="field"><label>Thème de la période</label><input @bind="p.Theme" /></div>
                </div>
            }

            <h3>Piliers de contenu <span class="muted small">(total : @form.Pillars.Sum(p => p.Share) %)</span></h3>
            <FieldError Errors="errors" For="Pillars" />
            @foreach (var p in form.Pillars)
            {
                <div class="plan-edit-pillar">
                    <div class="field"><label>Nom</label><input @bind="p.Name" /></div>
                    <div class="field"><label>Part (%)</label><input type="number" min="0" max="100" @bind="p.Share" /></div>
                    <div class="field plan-edit-desc"><label>Description</label><input @bind="p.Description" /></div>
                </div>
            }
            <div class="actions">
                <BusyButton OnClick="SaveAsync" IsBusy="@(action == "save")" BusyText="Enregistrement…">Enregistrer</BusyButton>
            </div>
        </details>
    }

    <div class="admin-card plan-advanced">
        <h2>Autres réglages</h2>
        <ul>
            <li><a href="/admin/pilote-automatique">Publics visés, heures, consignes d'écriture et réseaux</a></li>
            <li><a href="/admin/planche">Planche d'essai des visuels (styles d'images)</a></li>
            <li><a href="/admin/publications">Liste de toutes les publications</a></li>
        </ul>
    </div>

    @if (v.Status == PlanStatus.Active && !stopping)
    {
        <div class="admin-card plan-danger">
            <div>
                <h2>Arrêter cette campagne</h2>
                <p class="muted small">Elle passe dans l'historique et ses publications à venir sont annulées.</p>
            </div>
            <button class="btn btn-outline-danger" @onclick="StartStopping" disabled="@busy">Arrêter la campagne</button>
        </div>
    }
    }
}

@code {
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-CA");
    private MarketingPlanView? view;
    private MarketingPlanForm? form;
    private IReadOnlyList<PlanSummary> plans = [];
    private PlanSummary? activePlan;
    private Guid? selectedId;
    private bool afterCurrent;
    private bool stopping;
    private bool pauseAutopilot = true;
    private bool paused;
    private IReadOnlyDictionary<string, string>? errors;
    private bool loaded;
    private bool creating;
    private DateOnly today;
    private DateOnly startsOn;
    private int postsPerWeek = 7;
    private string? working;
    private string? feedback;
    private bool feedbackIsError;
    private bool busy;
    private string? action;

    protected override async Task OnInitializedAsync()
    {
        today = Hub.SharedKernel.Time.BusinessTime.Today(Clock);
        // Par défaut : le lundi qui vient.
        startsOn = today.AddDays(((int)DayOfWeek.Monday - (int)today.DayOfWeek + 7) % 7 is 0 ? 7 : ((int)DayOfWeek.Monday - (int)today.DayOfWeek + 7) % 7);
        await LoadAsync();
    }

    private async Task LoadAsync(bool reloadForm = true)
    {
        plans = await Plans.ListAsync();
        activePlan = plans.FirstOrDefault(p => p.Status == PlanStatus.Active);
        if (selectedId is { } id && plans.All(p => p.Id != id)) selectedId = null;
        view = selectedId is { } sel ? await Plans.GetAsync(sel) : await Plans.GetAsync();
        if (reloadForm) form = view is null ? null : await Plans.GetFormAsync(view.Id);
        if (view?.Status != PlanStatus.Active) stopping = false;
        paused = await Plans.IsPausedAsync();
        loaded = true;
    }

    private async Task SelectAsync(Guid id)
    {
        selectedId = id;
        feedback = null;
        errors = null;
        await LoadAsync();
    }

    private Task TogglePauseAsync() => RunAsync("pause", "Enregistrement…", async () =>
        (await Plans.SetPausedAsync(!paused), paused
            ? "Campagne reprise : la semaine est complétée tout de suite."
            : "Campagne en pause : plus aucune nouvelle publication n'est préparée."));

    private async Task StartStopping()
    {
        stopping = true;
        // La confirmation s'affiche sous la liste des plans : on y va (utile sur téléphone).
        StateHasChanged();
        await Task.Yield();
        await Js.InvokeVoidAsync("eval", "document.querySelector('.plan-stop')?.scrollIntoView({behavior:'smooth',block:'start'})");
    }

    private void StartCreating()
    {
        creating = true;
        afterCurrent = activePlan is not null;
        feedback = null;
    }

    private Task CreateAsync() => RunAsync("create", "Création du plan…", async () =>
    {
        var r = await Plans.CreateAsync(startsOn, postsPerWeek, activePlan is not null && afterCurrent);
        if (r.IsSuccess) { creating = false; selectedId = r.Value; }
        return (r, activePlan is null
            ? "Plan créé en brouillon : relisez-le, ajustez-le au besoin, puis lancez-le."
            : afterCurrent
                ? $"Plan créé en réserve : il démarrera tout seul le {AdminFormat.Day(activePlan.EndsOn.AddDays(1))}, à la fin du plan en cours."
                : "Plan créé en réserve : vous pourrez le lancer quand le plan en cours sera terminé ou arrêté.");
    });

    private Task ActivateAsync() => RunAsync("activate", "Lancement du plan…", async () =>
        (await Plans.ActivateAsync(view!.Id), "Campagne démarrée : ses publications sont en préparation et apparaissent dans le calendrier."));

    private Task StopAsync() => RunAsync("stop", "Arrêt du plan…", async () =>
    {
        var r = await Plans.StopAsync(view!.Id, pauseAutopilot);
        if (r.IsSuccess) stopping = false;
        return (r, pauseAutopilot
            ? "Campagne arrêtée : elle est dans l'historique, ses publications à venir sont annulées et la préparation est en pause."
            : "Campagne arrêtée : elle est dans l'historique, ses publications à venir sont annulées. La préparation continue sans campagne.");
    });

    private async Task ToggleAutoStartAsync(ChangeEventArgs e)
    {
        var on = e.Value is true || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await RunAsync("autostart", "Enregistrement…", async () =>
            (await Plans.SetAutoStartAsync(view!.Id, on), on
                ? "Cette campagne démarrera toute seule" + (activePlan is null ? " à sa date de début." : $" le {AdminFormat.Day(activePlan.EndsOn.AddDays(1))}, à la fin de la campagne en cours.")
                : "Démarrage automatique annulé : la campagne reste en réserve."));
    }

    private Task DeleteDraftAsync() => RunAsync("delete", "Suppression du plan…", async () =>
    {
        var r = await Plans.DeleteDraftAsync(view!.Id);
        if (r.IsSuccess) selectedId = null;
        return (r, "Campagne supprimée.");
    });

    private Task SaveAsync() => RunAsync("save", "Enregistrement du plan…", async () =>
    {
        var r = await Plans.SaveAsync(view!.Id, form!);
        errors = r.FieldErrors;
        return (r, "Campagne enregistrée.");
    }, reloadForm: false);

    private Task ApproveTargetsAsync() => RunAsync("targets", "Enregistrement des cibles…", async () =>
        (await Plans.ApproveTargetsAsync(), "Cibles approuvées : la trajectoire est suivie chaque semaine."));

    private Task ApprovePillarsAsync() => RunAsync("pillars", "Application de la nouvelle répartition…", async () =>
        (await Plans.ApprovePillarsAsync(), "Nouvelle répartition appliquée aux prochaines publications."));

    private Task DismissAsync() => RunAsync("dismiss", "…", async () =>
        (await Plans.DismissProposalAsync(), "Répartition actuelle conservée."));

    private Task AutoPublishAsync() => RunAsync("auto", "…", async () =>
        (await Plans.EnableAutoPublishAsync(), "Les publications du pilote partiront désormais seules à l'heure prévue."));

    private Task RefreshAsync() => RunAsync("refresh", "Relevé des chiffres auprès de Facebook et d'Instagram…", async () =>
        (await Plans.RefreshAsync(), "Chiffres à jour."));

    private async Task RunAsync(string name, string message, Func<Task<(Result Result, string Success)>> work, bool reloadForm = true)
    {
        if (busy) return;
        busy = true;
        action = name;
        working = message;
        feedback = null;
        await Task.Yield();
        try
        {
            var (result, success) = await work();
            feedbackIsError = result.IsFailure;
            feedback = result.IsSuccess ? success : result.Error ?? "Vérifiez les champs signalés.";
            if (result.IsSuccess) await LoadAsync(reloadForm);
        }
        finally
        {
            busy = false;
            action = null;
            working = null;
        }
    }

    private double NowPosition(PlanPhase p) =>
        Math.Clamp(100.0 * (today.DayNumber - p.From.DayNumber) / Math.Max(1, p.To.DayNumber - p.From.DayNumber), 0, 100);

    private static string Pct(double v) => v.ToString("0.#", Fr) + " %";

    private string StatusLabel(PlanStatus s) => s switch
    {
        PlanStatus.Active => "En cours",
        PlanStatus.Draft => activePlan is null ? "Pas démarrée" : "En réserve",
        PlanStatus.Stopped => "Arrêtée",
        _ => "Terminée",
    };

    private static string StatusClass(PlanStatus s) => s switch
    {
        PlanStatus.Active => "active",
        PlanStatus.Draft => "approval",
        _ => "lost",
    };

    private static string RythmLabel(int n) => n > 7 ? $"{n} (jusqu'à {AutopilotSchedule.PerDay(n)} par jour)" : n.ToString();

    private static RenderFragment Kpi(string label, string value, string? baseline, string? target, bool? onTrack) => __builder =>
    {
        <div class="kpi @(onTrack == true ? "kpi-accent" : null)">
            <span>@label</span>
            <strong>@value</strong>
            <small class="muted">
                @(baseline is null ? "Départ : à mesurer" : $"Départ : {baseline}")
                @(target is null ? "" : $" · Cible : {target}")
            </small>
            @if (onTrack == false) { <small class="plan-late">En retard sur la trajectoire</small> }
        </div>
    };
}
