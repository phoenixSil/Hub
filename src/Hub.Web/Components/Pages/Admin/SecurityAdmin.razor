@page "/admin/securite"
@rendermode InteractiveServer
@inject UserManager<HubUser> Users
@inject AuthenticationStateProvider Auth
@inject ICurrentTenant CurrentTenant
@using Microsoft.AspNetCore.Identity
@using QRCoder

<PageTitle>Sécurité du compte</PageTitle>

<div class="admin-head">
    <div>
        <h1>Sécurité du compte</h1>
        <p class="muted">Vérification en deux étapes et mot de passe de @user?.Email.</p>
    </div>
</div>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "alert-error" : "alert-success")">@message</div>
}

@if (user is null)
{
    <p class="muted">Chargement…</p>
}
else
{
    <div class="admin-card">
        <h2>Vérification en deux étapes</h2>

        @if (recoveryCodes is not null)
        {
            <div class="alert alert-success">
                <strong>Notez ces codes de récupération et gardez-les en lieu sûr.</strong>
                Chacun permet une connexion si vous perdez votre téléphone. Ils ne seront plus affichés.
            </div>
            <ul class="recovery-codes">
                @foreach (var recoveryCode in recoveryCodes)
                {
                    <li><code>@recoveryCode</code></li>
                }
            </ul>
            <button class="btn btn-outline btn-sm" @onclick="() => recoveryCodes = null">J'ai noté mes codes</button>
        }
        else if (enabled)
        {
            <p><span class="status status-won">Activée</span> Un code de votre application vous est demandé à chaque connexion.</p>
            <p class="muted small">Codes de récupération restants : @recoveryLeft</p>
            <div class="admin-actions">
                <button class="btn btn-outline btn-sm" @onclick="RegenerateCodesAsync">Générer de nouveaux codes de récupération</button>
                @if (confirmDisable)
                {
                    <button class="btn btn-sm btn-danger" @onclick="DisableAsync">Confirmer la désactivation</button>
                    <button class="btn btn-link" @onclick="() => confirmDisable = false">Annuler</button>
                }
                else
                {
                    <button class="btn-link danger" @onclick="() => confirmDisable = true">Désactiver</button>
                }
            </div>
        }
        else
        {
            <p><span class="status status-lost">Désactivée</span> Protégez le back-office : même avec votre mot de passe, personne ne pourra se connecter sans votre téléphone.</p>
            <ol class="setup-steps">
                <li>Installez une application d'authentification : Microsoft Authenticator, Google Authenticator ou l'application de votre gestionnaire de mots de passe.</li>
                <li>
                    Scannez ce code QR, ou entrez la clé à la main :
                    <div class="qr-setup">
                        <div class="qr">@((MarkupString)qrSvg)</div>
                        <code class="manual-key">@FormattedKey</code>
                    </div>
                </li>
                <li>
                    Entrez le code à 6 chiffres affiché par l'application :
                    <div class="credit-input">
                        <input @bind="verificationCode" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="123456" />
                        <button class="btn btn-primary btn-sm" @onclick="EnableAsync" disabled="@string.IsNullOrWhiteSpace(verificationCode)">Activer</button>
                    </div>
                </li>
            </ol>
        }
    </div>

    <div class="admin-card">
        <h2>Changer le mot de passe</h2>
        <div class="field-row">
            <div class="field"><label>Mot de passe actuel</label><input type="password" @bind="currentPassword" autocomplete="current-password" /></div>
            <div class="field"><label>Nouveau mot de passe (12 caractères minimum)</label><input type="password" @bind="newPassword" autocomplete="new-password" /></div>
        </div>
        <button class="btn btn-outline btn-sm" @onclick="ChangePasswordAsync" disabled="@(string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))">Changer le mot de passe</button>
    </div>
}

@code {
    private HubUser? user;
    private bool enabled;
    private int recoveryLeft;
    private string? key;
    private string qrSvg = string.Empty;
    private string? verificationCode;
    private IEnumerable<string>? recoveryCodes;
    private bool confirmDisable;
    private string? currentPassword;
    private string? newPassword;
    private string? message;
    private bool messageIsError;

    private string FormattedKey => string.Join(" ", Enumerable.Range(0, ((key?.Length ?? 0) + 3) / 4)
        .Select(i => key!.Substring(i * 4, Math.Min(4, key.Length - i * 4)))).ToLowerInvariant();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        user = await Users.GetUserAsync(principal);
        if (user is null) return;

        enabled = await Users.GetTwoFactorEnabledAsync(user);
        recoveryLeft = await Users.CountRecoveryCodesAsync(user);
        if (!enabled) await LoadKeyAsync();
    }

    private async Task LoadKeyAsync()
    {
        key = await Users.GetAuthenticatorKeyAsync(user!);
        if (string.IsNullOrEmpty(key))
        {
            await Users.ResetAuthenticatorKeyAsync(user!);
            key = await Users.GetAuthenticatorKeyAsync(user!);
        }

        var issuer = (await CurrentTenant.GetAsync()).Name;
        var uri = $"otpauth://totp/{Uri.EscapeDataString(issuer)}:{Uri.EscapeDataString(user!.Email!)}?secret={key}&issuer={Uri.EscapeDataString(issuer)}&digits=6";
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
        qrSvg = new SvgQRCode(data).GetGraphic(5);
    }

    private async Task EnableAsync()
    {
        var code = (verificationCode ?? string.Empty).Replace(" ", string.Empty).Replace("-", string.Empty);
        var valid = await Users.VerifyTwoFactorTokenAsync(user!, Users.Options.Tokens.AuthenticatorTokenProvider, code);
        if (!valid)
        {
            Show("Code invalide. Vérifiez que l'heure de votre téléphone est juste, puis réessayez.", true);
            return;
        }

        await Users.SetTwoFactorEnabledAsync(user!, true);
        recoveryCodes = await Users.GenerateNewTwoFactorRecoveryCodesAsync(user!, 10);
        verificationCode = null;
        enabled = true;
        recoveryLeft = 10;
        Show("Vérification en deux étapes activée.", false);
    }

    private async Task RegenerateCodesAsync()
    {
        recoveryCodes = await Users.GenerateNewTwoFactorRecoveryCodesAsync(user!, 10);
        recoveryLeft = 10;
        Show("Nouveaux codes générés : les anciens ne fonctionnent plus.", false);
    }

    private async Task DisableAsync()
    {
        await Users.SetTwoFactorEnabledAsync(user!, false);
        await Users.ResetAuthenticatorKeyAsync(user!);
        confirmDisable = false;
        enabled = false;
        await LoadKeyAsync();
        Show("Vérification en deux étapes désactivée.", false);
    }

    private async Task ChangePasswordAsync()
    {
        var result = await Users.ChangePasswordAsync(user!, currentPassword!, newPassword!);
        if (result.Succeeded)
        {
            currentPassword = newPassword = null;
            Show("Mot de passe changé.", false);
        }
        else
        {
            Show(string.Join(" ", result.Errors.Select(e => e.Description)), true);
        }
    }

    private void Show(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }
}
