@page "/admin/demandes"
@rendermode InteractiveServer
@inject ILeadInbox Leads
@inject AuthenticationStateProvider Auth

<PageTitle>Demandes</PageTitle>

<div class="admin-head">
    <div>
        <h1>Demandes</h1>
        <p class="muted">Toutes les demandes reçues par le site. Les pourriels sont masqués sauf si vous les filtrez.</p>
    </div>
    <div class="actions">
        <BusyButton Class="btn btn-outline btn-sm" OnClick="CleanAsync" IsBusy="cleaning" AnyBusy="cleaning" BusyText="Nettoyage…">Nettoyer les pourriels</BusyButton>
        <a class="btn btn-outline btn-sm" href="/admin/demandes/export.csv" download>Exporter (CSV)</a>
    </div>
</div>

@if (feedback is not null)
{
    <div class="alert alert-success" role="status">@feedback</div>
}

<div class="admin-card filters">
    <select @bind="status" @bind:after="LoadAsync">
        <option value="">Tous les statuts</option>
        @foreach (var s in Enum.GetValues<LeadStatus>())
        {
            <option value="@s">@LeadLabels.Of(s) (@counts.GetValueOrDefault(s))</option>
        }
    </select>
    <select @bind="kind" @bind:after="LoadAsync">
        <option value="">Tous les types</option>
        @foreach (var k in Enum.GetValues<LeadKind>())
        {
            <option value="@k">@LeadLabels.Of(k)</option>
        }
    </select>
    <input type="search" placeholder="Nom, courriel ou téléphone" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />
</div>

<div class="admin-card">
    <LeadTable Items="items" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "statut")] private string? StatusQuery { get; set; }

    private string? status;
    private string? kind;
    private string? search;
    private List<Lead> items = [];
    private Dictionary<LeadStatus, int> counts = [];
    private bool cleaning;
    private string? feedback;

    protected override async Task OnInitializedAsync()
    {
        status = StatusQuery;
        await LoadAsync();
    }

    private async Task CleanAsync()
    {
        if (cleaning) return;
        cleaning = true;
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User;
            var n = await Leads.CleanSpamAsync(user.FindFirst("hub:name")?.Value ?? user.Identity?.Name ?? "Administrateur");
            feedback = n == 0 ? "Aucun pourriel trouvé parmi les demandes nouvelles ou perdues."
                : $"{n} demande(s) classée(s) en pourriel. Retrouvez-les avec le filtre « Pourriel » (bouton « Ce n'est pas un pourriel » sur chaque fiche).";
            await LoadAsync();
        }
        finally { cleaning = false; }
    }

    private async Task LoadAsync()
    {
        counts = await Leads.CountByStatusAsync();
        items = await Leads.ListAsync(new LeadListFilter(
            Enum.TryParse<LeadStatus>(status, out var s) ? s : null,
            Enum.TryParse<LeadKind>(kind, out var k) ? k : null,
            search));
    }
}
