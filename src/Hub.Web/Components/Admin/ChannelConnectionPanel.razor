@inject IChannelConnections Connections
@inject IPublisherResolver Publishers

<div class="admin-card">
    <div class="assistant-head">
        <h2>@PostLabels.Of(Channel)</h2>
        @if (status?.IsConnected == true)
        {
            <span class="tag tag-ok">Connectée : @status.AccountName</span>
        }
        else
        {
            <span class="tag tag-ko">Non connectée</span>
        }
    </div>

    @if (Publishers.IsSimulated)
    {
        <p class="muted small">Mode simulé : la connexion est acceptée sans appeler le réseau, et rien n'est publié pour de vrai.</p>
    }

    @if (feedback is not null)
    {
        <div class="alert @(feedbackIsError ? "alert-error" : "alert-success")">@feedback</div>
    }

    @if (Linked is not null && !(status?.IsConnected == true && !editing))
    {
        <details class="assistant-notes" open="@(status?.IsConnected != true)">
            <summary>Avant de connecter @PostLabels.Of(Channel)</summary>
            <ol>
                <li>Dans l'application Instagram : <strong>Paramètres → Type de compte et outils → Passer à un compte professionnel</strong> (catégorie « Entreprise »).</li>
                <li>Reliez-le à la page Facebook : sur la page, <strong>Paramètres → Comptes liés → Instagram → Connecter</strong>.</li>
                <li>Le jeton de la page Facebook doit inclure <code>instagram_basic</code>, <code>instagram_content_publish</code>
                    et <code>instagram_manage_insights</code> (pour les chiffres du plan marketing) :
                    dans l'Explorateur de l'API Graph, ajoutez ces autorisations, régénérez le jeton de page, puis reconnectez Facebook ci-dessus.</li>
                <li>Cliquez ensuite sur le bouton ci-dessous : le compte relié est trouvé automatiquement, aucun jeton à copier.</li>
            </ol>
        </details>
        <div class="actions">
            <BusyButton OnClick="ConnectLinkedAsync" IsBusy="busy" BusyText="Recherche du compte relié…">Connecter avec la page @PostLabels.Of(Linked.Source)</BusyButton>
            @if (editing) { <button class="btn btn-ghost btn-sm" @onclick="() => editing = false">Annuler</button> }
        </div>
    }
    else if (status?.IsConnected == true && !editing)
    {
        <p class="muted small">@(Linked is null ? "Page" : "Compte") n° @status.AccountId, connectée le @AdminFormat.Local(status.ConnectedAt!.Value, "d MMMM yyyy"). Le jeton est chiffré et n'est jamais réaffiché.</p>
        <div class="actions">
            <button class="btn btn-outline btn-sm" @onclick="() => editing = true">@(Linked is null ? "Changer de page ou de jeton" : "Reconnecter")</button>
            <button class="btn btn-ghost btn-sm" @onclick="DisconnectAsync">Déconnecter</button>
        </div>
    }
    else
    {
        <details class="assistant-notes" open="@(status?.IsConnected != true)">
            <summary>Comment obtenir l'identifiant et le jeton de la page</summary>
            <ol>
                <li>Sur <strong>developers.facebook.com</strong>, créez une application (type « Entreprise ») et ajoutez le produit « Pages ».</li>
                <li>Dans l'<strong>Explorateur de l'API Graph</strong>, choisissez votre application, demandez les autorisations <code>pages_show_list</code>, <code>pages_read_engagement</code>, <code>pages_manage_posts</code> et <code>read_insights</code> (chiffres du plan marketing), puis générez un jeton d'utilisateur.</li>
                <li>Transformez-le en jeton longue durée (outil « Débogueur de jeton d'accès » → « Étendre le jeton d'accès »).</li>
                <li>Appelez <code>me/accounts</code> avec ce jeton : copiez l'<strong>id</strong> et l'<strong>access_token</strong> de la page ScintiNet. Ce jeton de page n'expire pas.</li>
            </ol>
        </details>
        <div class="field-row">
            <div class="field"><label>Identifiant de la page</label><input @bind="accountId" @bind:event="oninput" placeholder="ex. 61583803468197" /></div>
            <div class="field"><label>Jeton de la page</label><input type="password" autocomplete="off" @bind="token" @bind:event="oninput" placeholder="EAAG…" /></div>
        </div>
        <div class="actions">
            <BusyButton OnClick="ConnectAsync" IsBusy="busy" Disabled="@(string.IsNullOrWhiteSpace(accountId) || string.IsNullOrWhiteSpace(token))" BusyText="Vérification auprès de Facebook…">Vérifier et connecter</BusyButton>
            @if (editing) { <button class="btn btn-ghost btn-sm" @onclick="() => editing = false">Annuler</button> }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ChannelType Channel { get; set; }

    private ConnectionStatus? status;
    private string? accountId;
    private string? token;
    private bool busy;
    private bool editing;
    private string? feedback;
    private bool feedbackIsError;

    private Hub.Modules.Channels.Publishers.ILinkedChannel? Linked => Publishers.LinkedFor(Channel);

    protected override async Task OnInitializedAsync() => status = await Connections.GetStatusAsync(Channel);

    private async Task ConnectLinkedAsync()
    {
        busy = true;
        feedback = null;
        StateHasChanged();
        await Task.Yield();
        var result = await Connections.ConnectLinkedAsync(Channel);
        busy = false;
        feedback = result.IsSuccess ? $"Compte {result.Value} connecté." : result.Error;
        feedbackIsError = result.IsFailure;
        if (result.IsSuccess) editing = false;
        status = await Connections.GetStatusAsync(Channel);
    }

    private async Task ConnectAsync()
    {
        busy = true;
        feedback = null;
        StateHasChanged();
        await Task.Yield();
        var result = await Connections.ConnectAsync(Channel, accountId ?? "", token ?? "");
        busy = false;
        token = null; // le jeton ne reste pas en mémoire de l'écran
        feedback = result.IsSuccess ? $"Page « {result.Value} » connectée." : result.Error;
        feedbackIsError = result.IsFailure;
        if (result.IsSuccess) editing = false;
        status = await Connections.GetStatusAsync(Channel);
    }

    private async Task DisconnectAsync()
    {
        await Connections.DisconnectAsync(Channel);
        feedback = "Page déconnectée.";
        feedbackIsError = false;
        status = await Connections.GetStatusAsync(Channel);
    }
}
